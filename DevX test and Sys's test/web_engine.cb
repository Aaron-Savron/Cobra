# Cobra Web Engine - HTML serving + mock API benchmark server.
#
# Single-threaded accept loop (the HTTP library deliberately forces
# Connection: close per response until a connection-state object exists).
#
# Routes:
#   GET  /                -> serves site/index.html (text/html) from disk
#   GET  /site            -> same file
#   GET  /api/ping        -> {"endpoint":"ping","us":N}            (latency probe)
#   GET  /api/fib?n=NN    -> {"endpoint":"fib","n":N,"result":R,...}  (CPU: recursion)
#   GET  /api/stress?n=NN -> {"endpoint":"stress","n":N,"result":R,...} (CPU: loop)
#   GET  /api/json?n=NN   -> JSON array of N records               (serialization)
#   POST /api/echo        -> {"method":"POST","received":N,...}    (body echo)
#   else                  -> 404 {"error":...}
#
# Run from the project root:  ./cobra build "DevX test and Sys's test/web_engine.cb" -o <bin>

# No module-level constants yet, so shared values live in tiny helpers.
def site_path() -> string: {
    return "DevX test and Sys's test/site/index.html"
}

# --- numeric formatting helpers (JSON has no number-to-string builtin) ---

# Write decimal representation of value at offset. Returns the new offset, or -1.
def write_i64_pos(dst: []u8, offset: i64, value: i64) -> i64 {
    divisor = 1
    n = value
    while n / divisor >= 10: {
        if divisor > 1000000000: {
            return -1
        }
        divisor = divisor * 10
    }
    pos = offset
    while divisor > 0: {
        if pos + 1 > len(dst): {
            return -1
        }
        digit = value / divisor
        dst[pos] = 48 + digit
        pos = pos + 1
        value = value - digit * divisor
        divisor = divisor / 10
    }
    return pos
}

def write_i64(dst: []u8, offset: i64, value: i64) -> i64 {
    if offset < 0: {
        return -1
    }
    if value < 0: {
        if offset + 1 > len(dst): {
            return -1
        }
        dst[offset] = 45
        return write_i64_pos(dst, offset + 1, 0 - value)
    }
    return write_i64_pos(dst, offset, value)
}

# Write a fixed-point value with one decimal place (tenths as i64).
def write_tenths(dst: []u8, offset: i64, tenths: i64) -> i64 {
    let v: i64 = tenths
    if v < 0: {
        v = 0 - v
    }
    pos = write_i64(dst, offset, v / 10)
    if pos < 0: {
        return -1
    }
    if pos + 2 > len(dst): {
        return -1
    }
    dst[pos] = 46
    dst[pos + 1] = 48 + v - (v / 10) * 10
    return pos + 2
}

# Write two lowercase hex digits for a byte value.
def write_hex_byte(dst: []u8, offset: i64, b: i64) -> i64 {
    if offset + 2 > len(dst): {
        return -1
    }
    let digits: string = "0123456789abcdef"
    dst[offset] = char_at(digits, b / 16)
    dst[offset + 1] = char_at(digits, b - (b / 16) * 16)
    return offset + 2
}

# --- request routing helpers ---

# True when the request target equals route or route followed by '?' (query).
def route_prefix(buf: []u8, meta: []i64, route: string) -> i64 {
    if len(meta) < 4: {
        return 0
    }
    route_len = len(route)
    target_len = meta[3]
    if target_len < route_len: {
        return 0
    }
    i = 0
    while i < route_len: {
        if buf[meta[2] + i] != char_at(route, i): {
            return 0
        }
        i = i + 1
    }
    if target_len == route_len: {
        return 1
    }
    if buf[meta[2] + route_len] == 63: {
        return 1
    }
    return 0
}

# Parse the integer value of "name=<digits>" from the target query string.
def query_i64(buf: []u8, meta: []i64, name: string, fallback: i64) -> i64 {
    if len(meta) < 4: {
        return fallback
    }
    target_start = meta[2]
    target_len = meta[3]
    q = -1
    i = 0
    while i < target_len: {
        if buf[target_start + i] == 63: {
            q = i
            i = target_len
        } else: {
            i = i + 1
        }
    }
    if q < 0: {
        return fallback
    }
    name_len = len(name)
    j = q + 1
    while j + name_len < target_len: {
        if buf[target_start + j] == char_at(name, 0): {
            k = 0
            same = 1
            while k < name_len: {
                if buf[target_start + j + k] != char_at(name, k): {
                    same = 0
                    k = name_len
                } else: {
                    k = k + 1
                }
            }
            if same == 1: {
                if buf[target_start + j + name_len] == 61: {
                    value = 0
                    d = j + name_len + 1
                    digits = 0
                    while d < target_len: {
                        c = buf[target_start + d]
                        if c >= 48: {
                            if c <= 57: {
                                value = value * 10 + c - 48
                                digits = digits + 1
                                d = d + 1
                            } else: {
                                d = target_len
                            }
                        } else: {
                            d = target_len
                        }
                    }
                    if digits > 0: {
                        return value
                    }
                    return fallback
                }
            }
        }
        j = j + 1
    }
    return fallback
}

# --- endpoint bodies ---

def build_ping(body: []u8, start_us: i64) -> i64 {
    pos = http_copy_text(body, 0, "{\"endpoint\":\"ping\",\"engine\":\"cobra\",\"us\":")
    pos = write_i64(body, pos, time_monotonic_us() - start_us)
    pos = http_copy_text(body, pos, "}")
    return pos
}

def fib(n: i64) -> i64: {
    if n < 2: {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

def build_fib(body: []u8, n: i64, start_us: i64) -> i64 {
    fib_start = time_monotonic_us()
    result = fib(n)
    fib_us = time_monotonic_us() - fib_start
    pos = http_copy_text(body, 0, "{\"endpoint\":\"fib\",\"n\":")
    pos = write_i64(body, pos, n)
    pos = http_copy_text(body, pos, ",\"result\":")
    pos = write_i64(body, pos, result)
    pos = http_copy_text(body, pos, ",\"fib_us\":")
    pos = write_i64(body, pos, fib_us)
    pos = http_copy_text(body, pos, ",\"us\":")
    pos = write_i64(body, pos, time_monotonic_us() - start_us)
    pos = http_copy_text(body, pos, "}")
    return pos
}

def build_stress(body: []u8, n: i64, start_us: i64) -> i64 {
    sum = 0
    i = 0
    while i < n: {
        sum = sum + i * i
        i = i + 1
    }
    pos = http_copy_text(body, 0, "{\"endpoint\":\"stress\",\"n\":")
    pos = write_i64(body, pos, n)
    pos = http_copy_text(body, pos, ",\"result\":")
    pos = write_i64(body, pos, sum)
    pos = http_copy_text(body, pos, ",\"us\":")
    pos = write_i64(body, pos, time_monotonic_us() - start_us)
    pos = http_copy_text(body, pos, "}")
    return pos
}

def build_json_records(body: []u8, count: i64, start_us: i64) -> i64 {
    pos = http_copy_text(body, 0, "{\"count\":")
    pos = write_i64(body, pos, count)
    pos = http_copy_text(body, pos, ",\"us\":")
    pos = write_i64(body, pos, time_monotonic_us() - start_us)
    pos = http_copy_text(body, pos, ",\"data\":[")
    i = 0
    while i < count: {
        if i > 0: {
            pos = http_copy_text(body, pos, ",")
        }
        pos = http_copy_text(body, pos, "{\"id\":")
        pos = write_i64(body, pos, i)
        pos = http_copy_text(body, pos, ",\"name\":\"item-")
        pos = write_i64(body, pos, i)
        pos = http_copy_text(body, pos, "\",\"score\":")
        pos = write_tenths(body, pos, i * 37 + 5)
        pos = http_copy_text(body, pos, ",\"active\":")
        if i - (i / 2) * 2 == 0: {
            pos = http_copy_text(body, pos, "true")
        } else: {
            pos = http_copy_text(body, pos, "false")
        }
        pos = http_copy_text(body, pos, "}")
        i = i + 1
    }
    pos = http_copy_text(body, pos, "]}")
    return pos
}

def build_echo(body: []u8, request: []u8, meta: []i64, start_us: i64) -> i64 {
    received = meta[9]
    pos = http_copy_text(body, 0, "{\"method\":\"POST\",\"received\":")
    pos = write_i64(body, pos, received)
    pos = http_copy_text(body, pos, ",\"hex\":\"")
    n = received
    if n > 16: {
        n = 16
    }
    i = 0
    while i < n: {
        pos = write_hex_byte(body, pos, request[meta[8] + i])
        i = i + 1
    }
    pos = http_copy_text(body, pos, "\",\"us\":")
    pos = write_i64(body, pos, time_monotonic_us() - start_us)
    pos = http_copy_text(body, pos, "}")
    return pos
}

# Build the HTTP response into caller buffers and write it to the client.
def send_response(client: i64, status: i64, ctype: string, body: []u8, body_size: i64) -> i64 {
    with region out: {
        headers = out.alloc_u8(128)
        header_bytes = http_copy_text(headers, 0, "Connection: close\r\nContent-Type: ")
        header_bytes = http_copy_text(headers, header_bytes, ctype)
        header_bytes = http_copy_text(headers, header_bytes, "\r\n")
        let header_view: []u8 = slice_u8(headers, 0, header_bytes)
        let body_view: []u8 = slice_u8(body, 0, body_size)
        response = out.alloc_u8(body_size + 512)
        progress = alloc_i64(1)
        sent = http_response_send(client, status, header_view, body_view, response, progress)
        free(progress)
        free(header_view)
        free(body_view)
        if is_ok(sent) == 0: {
            return -1
        }
    }
    return 0
}

# Route one parsed request and write the response.
def handle_request(client: i64, request: []u8, request_size: i64, meta: []i64, name: []i64, value: []i64) -> i64 {
    start_us = time_monotonic_us()
    with region r: {
        body = r.alloc_u8(262144)
        status = http_status_ok()
        ctype = "application/json"
        body_size = 0
        if http_request_method_is(request, meta, "GET") == 1: {
            if route_prefix(request, meta, "/api/ping") == 1: {
                body_size = build_ping(body, start_us)
            } else: {
                if route_prefix(request, meta, "/api/fib") == 1: {
                    n = query_i64(request, meta, "n", 28)
                    body_size = build_fib(body, n, start_us)
                } else: {
                    if route_prefix(request, meta, "/api/stress") == 1: {
                        n = query_i64(request, meta, "n", 200000)
                        body_size = build_stress(body, n, start_us)
                    } else: {
                        if route_prefix(request, meta, "/api/json") == 1: {
                            n = query_i64(request, meta, "n", 100)
                            if n > 1000: {
                                n = 1000
                            }
                            body_size = build_json_records(body, n, start_us)
                        } else: {
                            if route_prefix(request, meta, "/site") == 1: {
                                ctype = "text/html"
                                size = fs_size(site_path())
                                if size > 0: {
                                    read_result = fs_read_file_u8_checked(site_path(), body, size)
                                    if is_ok(read_result) == 0: {
                                        status = 500
                                        body_size = http_copy_text(body, 0, "{\"error\":\"read failed\"}")
                                    } else: {
                                        body_size = unwrap_ok(read_result)
                                    }
                                } else: {
                                    status = http_status_not_found()
                                    body_size = http_copy_text(body, 0, "{\"error\":\"no index file\"}")
                                }
                            } else: {
                                if route_prefix(request, meta, "/") == 1: {
                                    ctype = "text/html"
                                    size = fs_size(site_path())
                                    if size > 0: {
                                        read_result = fs_read_file_u8_checked(site_path(), body, size)
                                        if is_ok(read_result) == 0: {
                                            status = 500
                                            body_size = http_copy_text(body, 0, "{\"error\":\"read failed\"}")
                                        } else: {
                                            body_size = unwrap_ok(read_result)
                                        }
                                    } else: {
                                        status = http_status_not_found()
                                        body_size = http_copy_text(body, 0, "{\"error\":\"no index file\"}")
                                    }
                                } else: {
                                    status = http_status_not_found()
                                    body_size = http_copy_text(body, 0, "{\"error\":\"not found\"}")
                                }
                            }
                        }
                    }
                }
            }
        } else: {
            if http_request_method_is(request, meta, "POST") == 1: {
                if route_prefix(request, meta, "/api/echo") == 1: {
                    body_size = build_echo(body, request, meta, start_us)
                } else: {
                    status = http_status_not_found()
                    body_size = http_copy_text(body, 0, "{\"error\":\"not found\"}")
                }
            } else: {
                status = http_status_not_found()
                body_size = http_copy_text(body, 0, "{\"error\":\"method not allowed\"}")
            }
        }
        sent = send_response(client, status, ctype, body, body_size)
        net_close_checked(client)
        if sent == 0: {
            return 0
        }
    }
    return -1
}

def serve_http_once(server: i64) -> i64 {
    accepted = net_accept_checked(server)
    if is_ok(accepted) == 0: {
        return -1
    }
    let client: i64 = unwrap_ok(accepted)
    with region r: {
        request = r.alloc_u8(8192)
        received = net_recv_bytes_checked(client, request, 8192)
        if is_ok(received) == 0: {
            net_close_checked(client)
            return -1
        }
        let request_size: i64 = unwrap_ok(received)
        meta = alloc_i64(12)
        name = alloc_i64(2)
        value = alloc_i64(2)
        parsed = http_request_parse(request, request_size, meta, name, value)
        if is_ok(parsed) == 0: {
            with region err_region: {
                error_body = err_region.alloc_u8(64)
                error_size = http_copy_text(error_body, 0, "{\"error\":\"bad request\"}")
                send_response(client, 400, "application/json", error_body, error_size)
            }
            net_close_checked(client)
            free(value)
            free(name)
            free(meta)
            return -1
        }
        handled = handle_request(client, request, request_size, meta, name, value)
        free(value)
        free(name)
        free(meta)
        if handled == 0: {
            return 0
        }
    }
    return -1
}

def main() -> i64 {
    opened = net_socket_checked()
    if is_ok(opened) == 0: {
        print("cobra web engine: socket failed")
        return 1
    }
    let server: i64 = unwrap_ok(opened)
    net_reuseaddr_checked(server)
    bound = net_bind_checked(server, 18100)
    if is_ok(bound) == 0: {
        net_close_checked(server)
        print("cobra web engine: bind failed")
        return 1
    }
    listening = net_listen_checked(server, 128)
    if is_ok(listening) == 0: {
        net_close_checked(server)
        print("cobra web engine: listen failed")
        return 1
    }
    print("cobra web engine listening on port ")
    print(18100)
    served = 0
    start = time_monotonic_us()
    while true: {
        served_ok = serve_http_once(server)
        if served_ok == 0: {
            served = served + 1
            if served - (served / 1000) * 1000 == 0: {
                elapsed = time_monotonic_us() - start
                if elapsed > 0: {
                    print("served ")
                    print(served)
                    print(" requests (")
                    print(served * 1000000 / elapsed)
                    print(" req/s)")
                }
            }
        }
    }
    net_close_checked(server)
    return 0
}
