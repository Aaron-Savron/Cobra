# ABI contract suite: typed values stay composable without a runtime tensor object.

def add_f32(a: f32, b: f32) -> f32: {
    return a + b
}

def tensor_identity(x: tensor[2, 2]f32) -> tensor[2, 2]f32: {
    return x
}

def tensor_round_trip(x: tensor[2, 2]f32) -> tensor[2, 2]f32: {
    return tensor_identity(x)
}

def mix_classes(x: []f32, scale: f32, y: []f32, bias: i64) -> f32: {
    return x[0] * scale + y[0] + bias
}

def test_scalar_f32_abi(): {
    value = add_f32(1.25, 2.5)
    assert(value > 3.74)
    assert(value < 3.76)
    return 0
}

def test_mixed_argument_classes(): {
    x = alloc_f32(1)
    y = alloc_f32(1)
    x[0] = 2.0
    y[0] = 3.0
    value = mix_classes(x, 2.0, y, 4)
    assert(value > 10.99)
    assert(value < 11.01)
    free(x)
    free(y)
    return 0
}

def test_tensor_nested_round_trip(): {
    let source: tensor[2, 2]f32 = alloc_f32(4)
    source[0,0] = 7.0
    let result: tensor[2, 2]f32 = tensor_round_trip(source)
    assert(result[0,0] == 7.0)
    free(result)
    free(source)
    return 0
}

def test_view_borrow_release(): {
    let source: tensor[2, 2]f32 = alloc_f32(4)
    let view: tensor[2]f32 = slice_view(source, 1, 2)
    assert(view[0] == 0.0)
    free(view)
    free(source)
    return 0
}
