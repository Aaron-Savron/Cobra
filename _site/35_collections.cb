# Collections v1: unboxed lists and string-key dictionaries.
# Lists own their growable storage; dictionaries own their table and copied keys.

def test_collections(): {
    let values: list[i64] = [1, 2]
    append(values, 3)
    values[0] = 9
    assert(len(values) == 3)
    assert(values[0] == 9)
    assert(values[2] == 3)

    let metrics: dict[string]i64 = {"loss": 7, "step": 2}
    metrics["step"] = 3
    assert(len(metrics) == 2)
    assert(metrics["loss"] == 7)
    assert(get(metrics, "step", 0) == 3)
    assert(get(metrics, "missing", 42) == 42)
    assert(has(metrics, "loss") == 1)
    assert(has(metrics, "missing") == 0)

    free(values)
    free(metrics)
    return 0
}

def main(): {
    return test_collections()
}
