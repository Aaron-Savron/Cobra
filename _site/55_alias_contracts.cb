# Alias-aware buffers: out/readonly qualifiers on slice parameters.
#
# A readonly buffer is a compiler-enforced no-write contract. An out buffer
# is a write target that never aliases another buffer parameter, so the
# kernel selector can rely on the two being disjoint. Both facts are pure
# metadata in the direct emitter; they add no runtime checks and no objects.
#
# The element-wise loop below is index-pure, so it lowers straight to AVX2
# (vmovups, vaddps, vmovups) with the aliasing already proven by the types.

def elementwise_add(dst: out []f32, left: readonly []f32, right: readonly []f32) -> i64: {
    for i in len(dst): {
        dst[i] = left[i] + right[i]
    }
    return 0
}

def scale_into(dst: out []f32, src: readonly []f32, s: f32) -> i64: {
    for i in len(dst): {
        dst[i] = src[i] * s
    }
    return 0
}

def test_contract(): {
    a = alloc_f32(32)
    b = alloc_f32(32)
    c = alloc_f32(32)
    fill_f32(a, 1.0)
    fill_f32(b, 2.0)
    elementwise_add(c, a, b)
    assert(c[0] == 3.0)
    assert(c[31] == 3.0)
    scale_into(c, a, 4.0)
    assert(c[0] == 4.0)
    assert(c[31] == 4.0)
    return 0
}

def test_out_can_reuse_buffer(): {
    # An out buffer may also be a normal owned local; the qualifier only
    # matters at the call boundary.
    v = alloc_f32(16)
    fill_f32(v, 1.0)
    scale_into(v, v, 2.0)
    assert(v[0] == 2.0)
    return 0
}
