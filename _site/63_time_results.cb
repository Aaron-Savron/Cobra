# Time lane regression: libc failures and invalid timestamps use Result values.

# A small wrapper proves nested postfix propagation across the time helpers.
def elapsed_from_now() -> Result[i64, i64]: {
    start = time_precise_us_checked()?
    return time_elapsed_us_checked(start)?
}

def test_time_results(): {
    wall = time_now_checked()
    precise = time_precise_us_checked()
    ticks = time_clock_ticks_checked()
    elapsed = elapsed_from_now()
    monotonic_start = time_monotonic_us_checked()
    assert(is_ok(monotonic_start))
    let monotonic_start_value: i64 = unwrap_ok(monotonic_start)
    monotonic_elapsed = time_elapsed_monotonic_us_checked(monotonic_start_value)
    invalid = time_elapsed_us_checked(-1)

    assert(is_ok(wall))
    assert(unwrap_ok(wall) >= 0)
    assert(is_ok(precise))
    assert(unwrap_ok(precise) >= 0)
    assert(is_ok(ticks))
    assert(unwrap_ok(ticks) >= 0)
    assert(is_ok(elapsed))
    assert(unwrap_ok(elapsed) >= 0)
    assert(is_ok(monotonic_start))
    assert(is_ok(monotonic_elapsed))
    assert(unwrap_ok(monotonic_elapsed) >= 0)
    assert(is_ok(invalid) == 0)
    assert(unwrap_err(invalid) == 2)
    return 0
}
