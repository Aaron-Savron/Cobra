# Closures (phase 2c): anonymous `def(params) -> ret: { body }` literals that
# capture scalar variables from the enclosing function by value. A capture is
# a snapshot taken when the closure literal is evaluated, not a live
# reference - two closures created from the same function with different
# argument values close over independent copies. See ROADMAP.md for the
# scalar-only capture restriction and docs/REFERENCE.md for the full design.

def apply(f: fn(i64) -> i64, x: i64) -> i64: {
    return f(x)
}

def make_adder(n: i64) -> fn(i64) -> i64: {
    return def(x: i64) -> i64: { return x + n }
}

def test_capture_as_callback(): {
    let n: i64 = 7
    let mul: fn(i64) -> i64 = def(x: i64) -> i64: { return x * n }
    assert(apply(mul, 6) == 42)
    return 0
}

def test_capture_independent_snapshots(): {
    let add5: fn(i64) -> i64 = make_adder(5)
    let add100: fn(i64) -> i64 = make_adder(100)
    assert(add5(10) == 15)
    assert(add100(1) == 101)
    assert(add5(0) == 5)
    return 0
}

def test_capture_returned_from_function(): {
    let f: fn(i64) -> i64 = make_adder(1000)
    assert(f(1) == 1001)
    assert(f(-1) == 999)
    return 0
}
