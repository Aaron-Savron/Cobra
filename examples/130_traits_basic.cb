struct Circle: { radius: i64 }
struct Square: { side: i64 }

trait Shape: {
    def area() -> i64
}

impl Shape for Circle: {
    def area(c: Circle) -> i64: {
        return c.radius * c.radius * 3
    }
}

impl Shape for Square: {
    def area(s: Square) -> i64: {
        return s.side * s.side
    }
}

def test_circle_area(): {
    let c: Circle
    c.radius = 4
    assert(c.area() == 48)
    return 0
}

def test_square_area(): {
    let s: Square
    s.side = 5
    assert(s.area() == 25)
    return 0
}

def test_shape_usage_in_function(): {
    let c: Circle
    c.radius = 2
    let s: Square
    s.side = 3
    let total: i64 = c.area() + s.area()
    assert(total == 12 + 9)
    return 0
}
