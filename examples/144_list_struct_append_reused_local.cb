# A list[T] append must copy the struct's bytes, not the source expression's
# address. A loop that reuses one `let` local across iterations exercises
# exactly that: every append shares the same stack slot as its source, so a
# pointer-only append would silently alias every element to the loop's final
# value once the function returns.

struct Point: { x: i64, y: i64 }

def build_points(count: i64) -> list[Point]: {
    let pts: list[Point] = []
    let i = 0
    while i < count: {
        let p: Point
        p.x = i
        p.y = i * 10
        append(pts, p)
        i = i + 1
    }
    return pts
}

def test_append_reused_local_survives_return(): {
    let pts: list[Point] = build_points(5)
    assert(len(pts) == 5)
    let j = 0
    while j < 5: {
        let cur: Point = pts[j]
        assert(cur.x == j)
        assert(cur.y == j * 10)
        j = j + 1
    }
    return 0
}

def test_append_reused_local_same_function(): {
    let pts: list[Point] = []
    let k = 0
    while k < 4: {
        let q: Point
        q.x = k * 2
        q.y = k * 3
        append(pts, q)
        k = k + 1
    }
    assert(len(pts) == 4)
    let a: Point = pts[0]
    let b: Point = pts[1]
    let c: Point = pts[2]
    let d: Point = pts[3]
    assert(a.x == 0)
    assert(b.x == 2)
    assert(c.x == 4)
    assert(d.x == 6)
    assert(a.y == 0)
    assert(d.y == 9)
    return 0
}
