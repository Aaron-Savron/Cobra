# @parallel prints a distinct compile-time note for each reason it falls
# back to sequential execution, not just the nested-loop case. This example
# is compiled deliberately to observe stderr notes (see CI script); it also
# runs correctly under cobra test since the fallback is always safe,
# functionally, just not parallel.

def helper(x: i64) -> i64: {
    return x * 2
}

def test_call_fallback() -> i64: {
    let values: []f32 = alloc_f32(8)
    for i in len(values): {
        values[i] = 1.0
    }
    let out: []f32 = alloc_f32(8)
    @parallel: {
        for i in len(values): {
            out[i] = values[i] + helper(1)
        }
    }
    total = 0.0
    for i in len(out): {
        total = total + out[i]
    }
    assert(total == 24.0)
    return 0
}

def test_reduction_fallback() -> i64: {
    let values: []f32 = alloc_f32(8)
    for i in len(values): {
        values[i] = 1.0
    }
    sum = 0.0
    @parallel: {
        for i in len(values): {
            sum = sum + values[i]
        }
    }
    assert(sum == 8.0)
    return 0
}
