# Regression tests for user-authored f32 language features.

def test_nested_f32_ranges(): {
    values = alloc_f32(4)
    for i in len(values): {
        values[i] = 0.0
        for j in len(values): {
            values[i] = values[i] + 1.0
        }
    }
    # Each outer iteration accumulates four; four elements total 16.
    assert(sum_f32(values) == 16)
    free(values)
    return 0
}

def test_ordered_f32_comparisons(): {
    values = alloc_f32(2)
    values[0] = 1.0
    values[1] = 2.0
    for i in len(values): {
        if values[i] < 2.0: {
            values[i] = values[i] + 1.0
        }
    }
    assert(sum_f32(values) == 4)
    free(values)
    return 0
}
