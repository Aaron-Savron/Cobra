# Cobra tensor views: one source type, zero-copy transformations.
# reshape_view and slice_view preserve contiguous storage; transpose_view records
# strides and is intentionally rejected by contiguous-only kernels.

def test_tensor_views(): {
    let source: tensor[2, 3]f32 = alloc_f32(6)
    source[0] = 1.0
    source[1] = 2.0
    source[2] = 3.0
    source[3] = 4.0
    source[4] = 5.0
    source[5] = 6.0

    let reshaped: tensor[3, 2]f32 = reshape_view(source, 3, 2)
    assert(reshaped[0, 0] == 1.0)
    assert(reshaped[2, 1] == 6.0)

    let column: tensor[3]f32 = slice_view(source, 1, 3)
    assert(column[0] == 2.0)
    assert(column[2] == 4.0)

    let transposed: tensor[3, 2]f32 = transpose_view(source)
    assert(transposed[0, 1] == 4.0)
    assert(transposed[2, 0] == 3.0)

    # Views are borrows: release them before their owning tensor.
    free(reshaped)
    free(column)
    free(transposed)
    free(source)
    return 0
}

def main(): {
    test_tensor_views()
    return 0
}
