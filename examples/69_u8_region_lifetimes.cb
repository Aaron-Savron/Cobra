# Region-backed []u8 uses the same pointer-plus-element-count ABI as heap []u8.

def u8_region_early(flag: i64) -> i64: {
    with region scratch: {
        owner = scratch.alloc_u8(8)
        owner[0] = 65
        if flag == 1: {
            return 7
        }
        assert(len(owner) == 8)
    }
    return 3
}

def u8_maybe_fail(value: i64) -> i64: {
    if value < 0: {
        return 5
    }
    return 0
}

def u8_region_propagate(value: i64) -> i64: {
    with region scratch: {
        owner = scratch.alloc_u8(8)
        owner[0] = 66
        status = u8_maybe_fail(value)?
        assert(len(owner) == 8)
        assert(owner[0] == 66)
    }
    return 0
}

def test_u8_region_basic(): {
    with region scratch: {
        owner = scratch.alloc_u8(8)
        owner[0] = 65
        let view: []u8 = slice_u8(owner, 0, 4)
        assert(len(owner) == 8)
        assert(len(view) == 4)
        assert(view[0] == 65)
        free(view)
    }
    return 0
}

def test_u8_region_nested(): {
    with region outer: {
        outer_buf = outer.alloc_u8(8)
        outer_buf[0] = 70
        with region inner: {
            inner_buf = inner.alloc_u8(4)
            inner_buf[0] = 71
            let inner_view: []u8 = slice_u8(inner_buf, 0, 2)
            assert(inner_view[0] == 71)
            free(inner_view)
        }
        assert(outer_buf[0] == 70)
    }
    return 0
}

def test_u8_region_early_return(): {
    assert(u8_region_early(1) == 7)
    assert(u8_region_early(0) == 3)
    return 0
}

def test_u8_region_question_propagation(): {
    assert(u8_region_propagate(-1) == 5)
    assert(u8_region_propagate(1) == 0)
    return 0
}
