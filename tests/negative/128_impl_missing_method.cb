struct Circle: { radius: i64 }

trait Shape: {
    def area() -> i64
    def perimeter() -> i64
}

impl Shape for Circle: {
    def area(c: Circle) -> i64: {
        return c.radius * c.radius * 3
    }
}

def test_incomplete_impl(): {
    let c: Circle
    c.radius = 4
    assert(c.area() == 48)
    return 0
}
