struct Point: { x: i64, y: i64 }

impl Point: {
    def sum(p: Point) -> i64: {
        return p.x + p.y
    }
}

impl Point: {
    def sum(p: Point) -> i64: {
        return p.x - p.y
    }
}

def test_duplicate_plain_method(): {
    let p: Point
    p.x = 1
    p.y = 2
    assert(p.sum() == 3)
    return 0
}
